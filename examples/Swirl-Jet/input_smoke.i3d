! Eight-rank integration smoke for the three-component iin=4 inlet.
! Reuses the 385x385 table generated using input_LES.i3d: same transverse extent.
! Coarse grid and reduced Re test startup/I/O/MPI, not LES resolution or physics.
&BasicParam
itype=733
p_row=2
p_col=4
nx=65
ny=72
nz=72
istret=0
beta=1.5
xlx=8.
yly=8.
zlz=8.
nclx1=2
nclxn=2
ncly1=0
nclyn=0
nclz1=0
nclzn=0
iin=4
re=1000.
u1=0.5
u2=0.3
init_noise=0.
inflow_noise=0.
dt=0.001
ifirst=1
ilast=100
ilesmod=4
numscalar=2
iibm=0
ivisu=1
ipost=0
/End

&NumOptions
ifirstder=4
isecondder=5
ipinter=3
itimescheme=3
nu0nu=4.
cnu=0.44
/End

&InOutParam
irestart=0
inflowpath='./'
icheckpoint=50
ioutput=50
ilist=10
nvisu=1
/End

&Statistics
spinup_time=0
nstat=1
/End

&ibmstuff
rai=0.5
rao=1.
/End

&ScalarParam
Sc(1)=1.
cp(1)=1.
Ri(1)=0.
uset(1)=0.
Sc(2)=1.
cp(2)=1.
Ri(2)=0.
uset(2)=0.
nclxS1=2
nclxSn=2
nclyS1=0
nclySn=0
nclzS1=0
nclzSn=0
/End

&LESModel
jles=4
/End

&CASE
/End
